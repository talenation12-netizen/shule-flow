  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "CommonJS",
    "moduleResolution": "Node",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@repo/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src"]
}